# ── Neon / Vercel Postgres ────────────────────────────────────────────────
# Pull these automatically with `vercel env pull .env.development.local`
# after linking a Neon database in the Vercel dashboard (Storage tab).
# Locally you can paste your Neon pooled connection string here.
POSTGRES_URL="postgres://user:password@host/dbname?sslmode=require"

# ── App secrets ───────────────────────────────────────────────────────────
# The group code you hand out to your friends so they can register.
GROUP_CODE="change-me-to-a-secret-code"

# Secret used to sign auth tokens. Generate one with:  openssl rand -hex 32
AUTH_SECRET="change-me-32-bytes-hex"
